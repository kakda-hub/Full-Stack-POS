# Environment files - never commit real credentials
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local
pos-backend/.env
pos-backend/.env.*
!pos-backend/.env.example
pos-frontend/.env
pos-frontend/.env.*
!pos-frontend/.env.example

# Node
node_modules/
dist/

# OS / editor junk
.DS_Store
Thumbs.db
nul

# IDE / local tooling (dev-local, never versioned)
.vscode/
.kilo/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
build/
coverage/
.nyc_output

# Temporary files
tmp/
temp/
*.tmp
*.bak

# ── Main-branch exclusions ────────────────────────────────────────────────────
