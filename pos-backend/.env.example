# ═══════════════════════════════════════════════════════════════
# Database Connection
# ═══════════════════════════════════════════════════════════════
#
# ── Option A: TiDB Cloud (Production) ─────────────────────────
#   Connects to TiDB Cloud Serverless (MySQL-compatible).
#   SSL is required; set DB_SSL=true (default).
#
# ── Option B: Local MySQL (Dev/Testing) ───────────────────────
#   Connects to MySQL running in Docker container "db" or localhost.
#   SSL is not needed; set DB_SSL=false.
#   Default credentials from docker-compose:
#     DB_HOST=db        (Docker internal) or localhost (host machine)
#     DB_PORT=3306
#     DB_USER=root
#     DB_PASSWORD=rootpassword
#     DB_NAME=pos_db
#
# ═══════════════════════════════════════════════════════════════

# ── Active configuration (uncomment/comment as needed) ────────

# TiDB Cloud (Production)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your-tidb-username.root
DB_PASSWORD=your-tidb-password
DB_NAME=pos_db
DB_SSL=true

# Local MySQL (Dev) — uncomment to switch:
# DB_HOST=db
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=rootpassword
# DB_NAME=pos_db
# DB_SSL=false

# ═══════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ═══════════════════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════════════════
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=8h

# ═══════════════════════════════════════════════════════════════
# File Upload (Cloudinary)
# ═══════════════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
