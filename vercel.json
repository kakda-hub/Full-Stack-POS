{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/pos-system/browser",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://full-stack-pos.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
